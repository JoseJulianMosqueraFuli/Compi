# Backend configuration example. Copy to .env and adjust values.

# PostgreSQL connection (matches docker-compose.yml default)
DATABASE_URL=postgresql+psycopg://compi:compi@localhost:5432/compi

# Keep off for the personal HealthKit database. Use demo only with a separate database.
LEGACY_SYNC_MODE=off
# Set only for mobile ingestion. Generate locally with openssl rand -hex 32.
# An empty or short token disables the receiver.
HEALTHKIT_SYNC_TOKEN=

# Optional direct Huawei integration.
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=

# Background sync interval in minutes
SYNC_INTERVAL_MINUTES=60

# CORS allowed origins (comma-separated list of strings)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
